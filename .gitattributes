# 统一换行符，避免 Windows / macOS 协作时整文件 diff
* text=auto

*.js      text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf

*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.ico     binary
