# 复制成 eval/.env.local 再填，别把 .env.local 提交上去（已 gitignore）

# ---- 评测侧：插件生成话术用的模型 ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 生成侧：造合成简历用的模型（建议与评测侧不同厂商，避免自洽）----
# 变量名支持多种写法，填哪个都认：

# 通义千问（阿里 DashScope）
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx        # 也认 DASHSCOPE_API_KEY / ALIYUN_API_KEY
# QWEN_MODEL="qwen3.8-flash"              # 不填则用 qwen-plus

# 智谱 GLM
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxx
# GLM_MODEL=glm-4-plus

# 月之暗面 Kimi
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx

# 小米 MiMo（接口地址不确定时必须给）
# XIAOMI_API_KEY=xxxxxxxxxxxxxxxx         # 也认 MIMO_API_KEY
# XIAOMI_URL=https://api.xiaomimimo.com/v1/chat/completions
# XIAOMI_MODEL="mimo-v2.6-flash"

# 任意 OpenAI 兼容端点
# LLM_API_KEY=xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://your-endpoint/v1

# ---- 可选：全局默认 ----
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
